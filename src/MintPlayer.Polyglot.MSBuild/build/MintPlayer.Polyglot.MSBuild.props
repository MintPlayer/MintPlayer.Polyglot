<Project>

  <!-- Auto-imported near the TOP of the consuming project (NuGet build/ convention). Resolves the host
       RID and the packed native `polyglot` tool, and declares the default `.pg` item glob — all
       overridable: set $(PolyglotTool) to point at your own CLI (the CI hook), or add/remove
       @(PolyglotFile) items in the project. -->

  <PropertyGroup>
    <!-- Optional knobs: the ambient std prelude (the CLI lib flag, e.g. io,math) and the module root.
         PolyglotHostRid / PolyglotTool are also overridable here; their DEFAULTS are computed in the
         .targets file — the SDK hasn't defined NETCoreSdkPortableRuntimeIdentifier yet at props time. -->
    <PolyglotLib Condition="'$(PolyglotLib)' == ''"></PolyglotLib>
    <PolyglotRoot Condition="'$(PolyglotRoot)' == ''">$(MSBuildProjectDirectory)</PolyglotRoot>
    <!-- P38 / issue #69: opt in to source-origin info so a coverage run over the generated C# attributes
         hits back to the .pg (path AND line numbers) instead of reporting nothing for code in obj/.
         Off by default — the generated code is byte-identical without it. -->
    <PolyglotOriginInfo Condition="'$(PolyglotOriginInfo)' == ''">false</PolyglotOriginInfo>
    <!-- P40 B6: a subset of the pgconfig.json `targets` to build here, ';'- or ','-separated (e.g. csharp).
         Empty = every pgconfig target (D3: the consumer's pgconfig decides). -->
    <PolyglotTargets Condition="'$(PolyglotTargets)' == ''"></PolyglotTargets>
  </PropertyGroup>

  <ItemGroup>
    <PolyglotFile Include="**\*.pg" Exclude="$(DefaultItemExcludes);bin\**;obj\**" />
    <!-- Make .pg files visible in the IDE's solution explorer. -->
    <None Include="@(PolyglotFile)" Condition="'$(EnableDefaultItems)' != 'false'" />
    <!-- P40 review (#75): Visual Studio's fast up-to-date check skips MSBuild entirely unless an input it
         knows about changed — without these, editing or deleting a .pg (or the config/lockfile) in VS left
         the project "up to date". The project's own pgconfig.json/lockfile; a config in a parent folder is
         still a depfile input of the transpile itself. -->
    <UpToDateCheckInput Include="@(PolyglotFile)" />
    <UpToDateCheckInput Include="$(MSBuildProjectDirectory)\pgconfig.json" Condition="Exists('$(MSBuildProjectDirectory)\pgconfig.json')" />
    <UpToDateCheckInput Include="$(MSBuildProjectDirectory)\pgconfig.lock.json" Condition="Exists('$(MSBuildProjectDirectory)\pgconfig.lock.json')" />
  </ItemGroup>

</Project>
