<Project>

  <!-- Auto-imported near the BOTTOM of the consuming project. Transpiles each @(PolyglotFile) to a .cs
       in obj/ before CoreCompile (so generated types exist for IntelliSense too — design-time builds are
       NOT skipped, Grpc.Tools' hard-won lesson), incrementally via Inputs/Outputs (the tool path is an
       input, so a CLI upgrade forces regen). A companion always-run target re-adds the generated files
       when the transpile is skipped, and registers them as FileWrites so `dotnet clean` removes them.

       Consumer-settable properties (each documented where it is used below; README ".NET build integration"):
         PolyglotTargets     subset of the pgconfig `targets` for THIS build ("csharp", "csharp;typescript";
                             empty = all) - the CLI `only` flag                                   (P40 B6)
         PolyglotNamespace   csharp.namespace  } C# target options, CLI `target-option` flags;
         PolyglotClass       csharp.class      } they win over the project's pgconfig.json   (P40 B1)
         PolyglotAccess      csharp.access     }
         PolyglotOriginInfo  true = #line origin pragmas for coverage attribution             (P38)
         PolyglotWatch       false = don't register the .pg sources as dotnet-watch items
         PolyglotLib         the ambient std prelude list (pgconfig `lib`)
       Floors of the emitted C#: C# 11 + a .NET 8 BCL; std.collections Map<K, V> needs .NET 9. -->


  <PropertyGroup>
    <PolyglotOutDir>$(IntermediateOutputPath)polyglot\</PolyglotOutDir>
    <!-- P40 (issue #73, D17/D18): the CLI's bookkeeping lives in the intermediate directory, OUTSIDE
         PolyglotOutDir, one set per intermediate directory — so parallel TFM builds (net8;net10) never see,
         let alone delete, each other's outputs.
           * the outputs RECORD: what the last transpile produced. After a successful run the CLI deletes
             "previous minus current" (a renamed or deleted .pg leaves no stale .cs behind that still
             compiles), and only files carrying its own `Generated by Polyglot.` line.
           * the DEPFILE: every input the outputs depend on (pgconfig.json, the lockfile, every .pg of every
             closure — imported ones outside the project included — and file: plugin manifests).
           * the INPUTS CACHE: the .pg set plus every option that changes the emitted bytes, rewritten only
             when different. It replaces the old stamp-NAME tag (P38): flipping PolyglotOriginInfo,
             PolyglotTargets, PolyglotLib, PolyglotNamespace, PolyglotClass, PolyglotAccess or PolyglotRoot — or adding/removing a .pg — changes
             the file, so the target re-runs. Inputs/Outputs alone can never see a REMOVED item. -->
    <_PolyglotRecord>$(IntermediateOutputPath)polyglot.outputs.json</_PolyglotRecord>
    <_PolyglotDepfile>$(IntermediateOutputPath)polyglot.deps</_PolyglotDepfile>
    <_PolyglotInputsCache>$(IntermediateOutputPath)polyglot.inputs.cache</_PolyglotInputsCache>
    <_PolyglotStamp>$(IntermediateOutputPath)polyglot.stamp</_PolyglotStamp>
    <!-- Host RID: the SDK's portable RID (e.g. win-x64, linux-x64, osx-arm64), overridable. Resolved
         here (not the .props) because the SDK defines it after NuGet's top-of-project props import. -->
    <PolyglotHostRid Condition="'$(PolyglotHostRid)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</PolyglotHostRid>
    <_PolyglotToolName Condition="$([MSBuild]::IsOSPlatform('Windows'))">polyglot.exe</_PolyglotToolName>
    <_PolyglotToolName Condition="'$(_PolyglotToolName)' == ''">polyglot</_PolyglotToolName>
    <PolyglotTool Condition="'$(PolyglotTool)' == ''">$(MSBuildThisFileDirectory)..\tools\$(PolyglotHostRid)\$(_PolyglotToolName)</PolyglotTool>
  </PropertyGroup>

  <!-- dotnet watch monitors only Compile/EmbeddedResource by default; declaring the .pg sources as Watch
       items makes `dotnet watch build|run` on the consuming project re-run PolyglotTranspile on every .pg
       edit — the free Visual Studio/.NET watch path (PRD 4.13). Opt out per file with Watch="false"
       metadata on the PolyglotFile item (it flows through the transform), or entirely with the
       PolyglotWatch=false property. -->
  <ItemGroup Condition="'$(PolyglotWatch)' != 'false'">
    <Watch Include="@(PolyglotFile)" />
  </ItemGroup>

  <!-- Fail LOUDLY when no packed binary matches the host — a silent skip would cascade into misleading
       "type not found" errors far from the cause. -->
  <Target Name="_PolyglotVerifyTool" Condition="'@(PolyglotFile)' != ''">
    <Error Condition="!Exists('$(PolyglotTool)')"
           Text="MintPlayer.Polyglot.MSBuild: no polyglot binary for host RID '$(PolyglotHostRid)' (looked at '$(PolyglotTool)'). Set the PolyglotTool property to a polyglot CLI for this platform." />
    <!-- NuGet extraction drops the exec bit on unix. -->
    <Exec Condition="!$([MSBuild]::IsOSPlatform('Windows'))" Command="chmod +x &quot;$(PolyglotTool)&quot;" />
  </Target>

  <!-- P40 D17: refresh the inputs cache (WriteOnlyWhenDifferent keeps its mtime when nothing changed) and
       read the depfile the previous transpile wrote. A dependency that has since been deleted is a missing
       Input, which MSBuild treats as out of date — exactly right for a removed import. -->
  <Target Name="_PolyglotPrepareInputs" Condition="'@(PolyglotFile)' != ''">
    <ItemGroup>
      <_PolyglotCacheLine Include="@(PolyglotFile->'%(FullPath)')" />
      <_PolyglotCacheLine Include="targets=$(PolyglotTargets)" />
      <_PolyglotCacheLine Include="lib=$(PolyglotLib)" />
      <_PolyglotCacheLine Include="namespace=$(PolyglotNamespace)" />
      <_PolyglotCacheLine Include="class=$(PolyglotClass)" />
      <_PolyglotCacheLine Include="access=$(PolyglotAccess)" />
      <_PolyglotCacheLine Include="origin=$(PolyglotOriginInfo)" />
      <_PolyglotCacheLine Include="root=$(PolyglotRoot)" />
    </ItemGroup>
    <WriteLinesToFile File="$(_PolyglotInputsCache)" Lines="@(_PolyglotCacheLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ReadLinesFromFile File="$(_PolyglotDepfile)" Condition="Exists('$(_PolyglotDepfile)')">
      <Output TaskParameter="Lines" ItemName="_PolyglotDep" />
    </ReadLinesFromFile>
  </Target>

  <!-- §4.5 module linking: transpile the WHOLE .pg set in ONE CLI invocation (not batched per file). The CLI
       links cross-module imports into references (each type/function defined once) and emits one flat .cs per
       .pg module — so compiling them all into one assembly no longer hits CS0101. A per-file invocation would
       double-emit shared library modules and clash on the C# `partial` wrapper. Output is flat (basename.cs),
       so .pg filenames must be unique across the project (v1 — see PRD §3.B).

       Incrementality is keyed on a single STATIC stamp, NOT a per-file Outputs map (PRD §4.19 / PLAN P28).
       Why: with a per-file `Outputs="@(PolyglotFile->'…%(Filename).cs')"` map, MSBuild's up-to-date check
       runs this target with @(PolyglotFile) FILTERED to just the stale file(s) — so the Exec below calls the
       CLI with a SUBSET. The CLI keys standalone-vs-project emit on input COUNT (one input → a non-`partial`
       PolyglotProgram + inline prelude; many → the shared __polyglot_prelude.cs + `partial` wrapper), so a
       one-file incremental rebuild regenerates that unit STANDALONE and it collides with its siblings + the
       retained prelude → CS0101/CS0260/CS8863 (a miscompile). A single stamp Output makes the target
       un-batchable and all-or-nothing: any stale input re-runs the CLI over the FULL set, so it always sees
       inputs.size()>1 and emits in project mode.

       P40 (D17): the old RemoveDir is gone. It could never run when it mattered — a removed or renamed .pg
       is invisible to Inputs/Outputs (and a rename keeps the mtime) — so a deleted .pg's function kept
       linking from the stale .cs. Now the inputs cache re-runs the target on any change to the .pg SET, and
       the CLI's outputs record (`record`, below) deletes exactly the stale outputs, TS twins included. -->
  <Target Name="PolyglotTranspile"
          BeforeTargets="CoreCompile"
          DependsOnTargets="_PolyglotVerifyTool;_PolyglotPrepareInputs"
          Condition="'@(PolyglotFile)' != ''"
          Inputs="@(PolyglotFile);$(PolyglotTool);$(_PolyglotInputsCache);@(_PolyglotDep)"
          Outputs="$(_PolyglotStamp)">
    <PropertyGroup>
      <_PolyglotLibArg></_PolyglotLibArg>
      <_PolyglotLibArg Condition="'$(PolyglotLib)' != ''"> --lib &quot;$(PolyglotLib)&quot;</_PolyglotLibArg>
      <!-- P40 B1: C# target options, passed as `target-option csharp.<name>=<value>` (they win over the
           pgconfig "targetOptions.csharp" block). PolyglotNamespace puts the generated code in a file-scoped
           namespace; PolyglotClass renames the PolyglotProgram wrapper; PolyglotAccess=public emits `public`
           on the generated types (usable across assemblies with no hand-written facade). Unset = the
           plugin defaults (no namespace, PolyglotProgram, C#'s modifier-less internal). -->
      <_PolyglotTargetOptionArgs></_PolyglotTargetOptionArgs>
      <_PolyglotTargetOptionArgs Condition="'$(PolyglotNamespace)' != ''">$(_PolyglotTargetOptionArgs) --target-option &quot;csharp.namespace=$(PolyglotNamespace)&quot;</_PolyglotTargetOptionArgs>
      <_PolyglotTargetOptionArgs Condition="'$(PolyglotClass)' != ''">$(_PolyglotTargetOptionArgs) --target-option &quot;csharp.class=$(PolyglotClass)&quot;</_PolyglotTargetOptionArgs>
      <_PolyglotTargetOptionArgs Condition="'$(PolyglotAccess)' != ''">$(_PolyglotTargetOptionArgs) --target-option &quot;csharp.access=$(PolyglotAccess)&quot;</_PolyglotTargetOptionArgs>
      <!-- PolyglotOriginInfo=true records where each emitted line came from (P38 / issue #69), so a
           coverage run over the generated C# in obj/ reports against the .pg file with .pg line numbers
           instead of being invisible. Roslyn writes the #line pragmas into the PDB, so nothing needs
           post-processing. Off by default: the generated code is byte-identical without it. -->
      <_PolyglotOriginInfoArg></_PolyglotOriginInfoArg>
      <_PolyglotOriginInfoArg Condition="'$(PolyglotOriginInfo)' == 'true'"> --origin-info</_PolyglotOriginInfoArg>
      <!-- P40 B6: PolyglotTargets=csharp (or "csharp;typescript") limits THIS build to a subset of the
           pgconfig `targets` (empty = all of them, D3). The recipe for Nx and other cached monorepos:
           PolyglotTargets=csharp here, plus `polyglot build` with the check flag and only=typescript in CI
           for the committed TS twin (README; an XML comment cannot spell the double-dash flags). Include routing is unchanged, and the record's sections for the other
           targets carry over untouched — a csharp-only build never deletes a TS twin. -->
      <_PolyglotOnlyArg></_PolyglotOnlyArg>
      <_PolyglotOnlyArg Condition="'$(PolyglotTargets)' != ''"> --only &quot;$(PolyglotTargets.Replace(';', ','))&quot;</_PolyglotOnlyArg>
    </PropertyGroup>
    <MakeDir Directories="$(PolyglotOutDir)" />
    <!-- P30 slice 7: no language flag — the consumer's pgconfig.json decides the target set (it must
         declare at least "targets": ["csharp"]; the CLI's refusal names that fix). MSBuild passes files
         and paths, never languages. The `out` flag below is the DEFAULT sink: csharp (no include rule)
         lands in obj/ and compiles exactly as before; other targets route through the pgconfig `include`
         rules (e.g. TypeScript twins into a web app's src) and are deliberately NOT in @(FileWrites) —
         they are committed source artifacts `dotnet clean` must never delete. -->
    <Exec Command="&quot;$(PolyglotTool)&quot; build @(PolyglotFile->'&quot;%(FullPath)&quot;', ' ') --out &quot;$(PolyglotOutDir).&quot; --root &quot;$(PolyglotRoot)&quot;$(_PolyglotLibArg)$(_PolyglotTargetOptionArgs)$(_PolyglotOriginInfoArg)$(_PolyglotOnlyArg) --record &quot;$(_PolyglotRecord)&quot; --depfile &quot;$(_PolyglotDepfile)&quot;" />
    <Touch Files="$(_PolyglotStamp)" AlwaysCreate="true" />
  </Target>

  <!-- Always runs (no Inputs/Outputs): when PolyglotTranspile was skipped as up-to-date, the compiler still
       needs the previously generated files in @(Compile). Glob every generated .cs rather than mapping one
       per .pg: a 2+-.pg project also emits the shared __polyglot_prelude.cs (issue #14), which has no source
       .pg. The glob compiles + cleans it too; a single-.pg project still yields just its one .cs. -->
  <Target Name="_PolyglotAddGenerated"
          BeforeTargets="CoreCompile"
          AfterTargets="PolyglotTranspile"
          Condition="'@(PolyglotFile)' != ''">
    <ItemGroup>
      <_PolyglotGenerated Include="$(PolyglotOutDir)*.cs" />
      <Compile Include="@(_PolyglotGenerated)" />
      <FileWrites Include="@(_PolyglotGenerated)" />
      <!-- The bookkeeping (never compiled) — registered so `dotnet clean` removes it. -->
      <FileWrites Include="$(_PolyglotStamp);$(_PolyglotRecord);$(_PolyglotDepfile);$(_PolyglotInputsCache)" />
    </ItemGroup>
  </Target>

</Project>
