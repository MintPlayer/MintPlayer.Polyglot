// REFUSED (P40 review r4 #7): a class is defined only after its base class, so an initializer that constructs
// one whose base is declared later cannot run in declaration order on TS or Python (the class moves after its
// base, and so would have to the value — past declarations that may read it).
import "std.io"

class Derived : Base {
}

let made: Derived = Derived()

open class Base {
  fn hello(): string => "hello"
}

fn main() {
  print(made.hello())
}
