// P40 review r7 (gating 1) - Spark r5_h_fieldalias.
import "std.io"

// rule 5 MUST REFUSE: the constructor stores a lambda capturing an ALIAS of `this` in its own field, then CALLS the
// field (the lambda calls the overridable method)
open class Base {
  var cb: () => string = () => "none"
  var label: string = ""
  constructor() {
    let me = this
    this.cb = () => me.describe()
    this.label = this.cb()
  }
  open fn describe(): string => "base"
}
class Derived : Base {
  var extra: string = "X"
  override fn describe(): string => "derived" + this.extra
}

fn main() {
  print(Derived().label)
}
