// issue #34: string.codePointAt — the portable char→ordinal path (non-ASCII and astral cases: strings_astral.pg).

import "std.strings"

fn main() {
  print("A".codePointAt(0))      // 65
  print("Az9".codePointAt(1))    // 122
  print("Az9".codePointAt(2))    // 57
  print(" ".codePointAt(0))      // 32
  print("~".codePointAt(0))      // 126
}
