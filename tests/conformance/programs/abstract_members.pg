// P40 review r5 #9: `abstract class` / `abstract fn` are real abstract members on every target — C#, TS and PHP
// `abstract`, Python `@abc.abstractmethod` on an `abc.ABC` class. Round 4 emitted an empty concrete method (C#
// CS0506 in every subclass, TS2355). Abstract bases with a constructor and field initializers, subclasses with and
// without a constructor, an abstract class deriving from another, and a call through the base type.
import "std.io"

abstract class Shape {
  var sides: i32 = 0
  var name: string
  constructor() {
    this.name = "shape"
    this.sides = 3
  }
  abstract fn area(): f64
  fn describe(): string => this.name + ":" + "${this.area()}"
}
class Tri : Shape {
  override fn area(): f64 => 1.5
}
class Sq : Shape {
  var w: f64
  constructor(w: f64) {
    this.w = w
  }
  override fn area(): f64 => this.w * this.w
}

abstract class Named {
  var nick: string = "n"
  abstract fn who(): string
}
abstract class Titled : Named {
  fn title(): string => "dr " + this.who()
}
class Anon : Titled {
  override fn who(): string => "anon:" + this.nick
}

fn total(shapes: Shape[]): f64 {
  var t = 0.0
  for s in shapes {
    t = t + s.area()
  }
  return t
}

fn main() {
  let t = Tri()
  print(t.name)
  print(t.sides)
  print(t.area())
  let s = Sq(2.0)
  print(s.describe())
  print(total([t, s]))
  let a = Anon()
  print(a.who())
  print(a.title())
  let n: Named = a
  print(n.who())
}
